<Project>
  <PropertyGroup>
    <Authors>SynesthesiaDev</Authors>
    <RepositoryUrl>https://github.com/SynesthesiaDev/Codon</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\"
          Link="README.md" />
  </ItemGroup>
</Project>
