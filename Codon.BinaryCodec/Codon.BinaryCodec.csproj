<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>SynesthesiaDev_</Authors>
        <Description>A .NET Codec library that can serialize into binary format</Description>
        <RepositoryUrl>https://github.com/SynesthesiaDev/Codon</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IsPackable>true</IsPackable>
        <PackageId>SynesthesiaDev.Codon.BinaryCodec</PackageId>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>1.0.1</Version>

        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>Codon.Binary</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Codon.Optionals\Codon.Optionals.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="DotNetty.Buffers" Version="0.7.6" />
      <PackageReference Include="SynesthesiaUtils" Version="2026.804.0" />
    </ItemGroup>

</Project>
